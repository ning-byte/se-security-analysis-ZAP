@startuml
!theme plain
skinparam packageStyle rectangle
skinparam defaultFontSize 10

' 缩小到70%大小
scale 0.7

title OWASP ZAP 体系结构图

package "GUI模块" {
  component MainFrame
  component SitesPanel
}

package "扩展插件模块" {
  component ExtensionAdaptor
  component ExtensionFactory
}

package "主动扫描模块" {
  component ActiveScanController
  component ActiveScan
}

package "被动扫描模块" {
  component PassiveScanThread
}

package "爬虫模块" {
  component Spider
}

package "代理核心模块" {
  component ProxyServer
  component HttpMessage
}

package "扫描引擎模块" {
  component Scanner
  component Plugin
}

package "报告模块" {
  component ReportGenerator
}

' 依赖关系
GUI模块 --> 扩展插件模块
扩展插件模块 --> 主动扫描模块
扩展插件模块 --> 被动扫描模块
扩展插件模块 --> 爬虫模块

主动扫描模块 --> 扫描引擎模块
被动扫描模块 --> 扫描引擎模块
爬虫模块 --> 代理核心模块
扫描引擎模块 --> 代理核心模块

报告模块 --> 主动扫描模块
报告模块 --> 被动扫描模块

@enduml